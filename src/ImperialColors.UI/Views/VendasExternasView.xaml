<UserControl x:Class="ImperialColors.UI.Views.VendasExternasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImperialColors.UI.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- URI absoluta (pack://): a relativa resolve contra o assembly de ENTRADA,
                     o que funciona com o app rodando mas quebra ao construir a tela em teste.
                     Mesmo padrão de PDVView, ProdutoFormView e NomeRapidoDialogView. -->
                <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:MoedaConverter x:Key="MoedaConverter"/>
            <conv:DataHoraConverter x:Key="DataHoraConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource TituloModulo}" Text="Vendas Externas"/>
                <TextBlock Text="Consolide vendas realizadas fora do estabelecimento físico"
                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding AbrirComissoesCommand}" Content="💰  Comissões"
                        ToolTip="Controle das comissões de venda externa — o que já foi pago e o que falta."/>
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding EditarVendaCommand}" Content="✏  Editar"/>
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding RegistrarTrocaCommand}" Content="↔  Registrar Troca"/>
                <Button Style="{StaticResource BotaoPerigo}" Margin="0,0,10,0"
                        Command="{Binding ExcluirVendaCommand}" Content="🗑  Excluir"/>
                <Button Style="{StaticResource BotaoPrimario}"
                        Command="{Binding RegistrarVendaCommand}" Content="+ Registrar Venda Externa"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridVendasExternas" Style="{StaticResource DataGridModerno}"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderModerno}"
                      ItemsSource="{Binding Vendas}" SelectedItem="{Binding VendaSelecionada}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Venda" Binding="{Binding NumeroVendaExterna}" Width="160"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataVenda, Converter={StaticResource DataHoraConverter}}" Width="150"/>
                    <DataGridTextColumn Header="Itens" Binding="{Binding TotalItens}" Width="70"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, Converter={StaticResource MoedaConverter}}" Width="110"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource MoedaConverter}}" Width="110"/>
                    <DataGridTextColumn Header="Comissão" Binding="{Binding Comissao, Converter={StaticResource MoedaConverter}}" Width="110"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding SituacaoComissao}" Width="110"/>
                    <DataGridTextColumn Header="Usuário" Binding="{Binding Usuario}" Width="*"/>
                    <DataGridTextColumn Header="Observações" Binding="{Binding Observacoes}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource CinzaTextoBrush}"
                           Text="{Binding InfoPaginacao}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BotaoSecundario}" Content="◀ Anterior"
                            Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BotaoSecundario}" Content="Próxima ▶"
                            Command="{Binding PaginaProximaCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
