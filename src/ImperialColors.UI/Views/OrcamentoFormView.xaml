<Window x:Class="ImperialColors.UI.Views.OrcamentoFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Orçamento" Width="980" Height="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource CinzaClaroBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="TxtTituloModulo" Text="Novo Orçamento"
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource PretoPrimarioBrush}"/>
                <TextBlock x:Name="TxtSubtituloModulo"
                           Text="Proposta comercial sem compromisso — não reserva estoque nem gera venda"
                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,15">
            <StackPanel>

                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Dados do cliente" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Nome do cliente *"/>
                                <TextBox x:Name="TxtNomeCliente" Style="{StaticResource TextBoxModerno}"
                                         TextChanged="TxtNomeCliente_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Telefone"/>
                                <TextBox x:Name="TxtTelefoneCliente" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Validade *"/>
                                <DatePicker x:Name="DpValidade" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtClienteVinculado" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource CinzaTextoBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Popup x:Name="PopupResultadosCliente"
                       PlacementTarget="{Binding ElementName=TxtNomeCliente}"
                       Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="8"
                            BorderBrush="{StaticResource CinzaMedioBrush}" BorderThickness="1"
                            MinWidth="{Binding ActualWidth, ElementName=TxtNomeCliente}"
                            MaxHeight="200" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.15"/>
                        </Border.Effect>
                        <ListBox x:Name="LstResultadosCliente" BorderThickness="0"
                                 MouseDoubleClick="LstResultadosCliente_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Telefone}" FontSize="11"
                                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Adicionar item" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="RbModoEstoque" Content="Buscar no estoque"
                                         GroupName="ModoItem" IsChecked="True" Margin="0,0,20,0"
                                         Checked="ModoItem_Changed"/>
                            <RadioButton x:Name="RbModoManual" Content="Digitar manualmente"
                                         GroupName="ModoItem" Checked="ModoItem_Changed"/>
                        </StackPanel>

                        <Grid x:Name="PainelModoEstoque">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Produto (nome, código ou barras)"/>
                                <TextBox x:Name="TxtBuscaProduto" Style="{StaticResource TextBoxModerno}"
                                         TextChanged="TxtBuscaProduto_TextChanged"
                                         KeyDown="TxtBuscaProduto_KeyDown"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Quantidade"/>
                                <TextBox x:Name="TxtQuantidadeEstoque" Style="{StaticResource TextBoxNumerico}" Text="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor unitário (R$)"/>
                                <TextBox x:Name="TxtPrecoEstoque" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>

                            <Button Grid.Column="6" Content="+ Adicionar"
                                    Style="{StaticResource BotaoSecundario}"
                                    VerticalAlignment="Bottom" Height="36"
                                    Click="BtnAdicionarItemEstoque_Click"/>
                        </Grid>

                        <Grid x:Name="PainelModoManual" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Descrição do item *"/>
                                <TextBox x:Name="TxtNomeManual" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Unidade"/>
                                <TextBox x:Name="TxtUnidadeManual" Style="{StaticResource TextBoxModerno}" Text="UN"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Quantidade"/>
                                <TextBox x:Name="TxtQuantidadeManual" Style="{StaticResource TextBoxNumerico}" Text="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor unitário (R$)"/>
                                <TextBox x:Name="TxtPrecoManual" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>

                            <Button Grid.Column="8" Content="+ Adicionar"
                                    Style="{StaticResource BotaoSecundario}"
                                    VerticalAlignment="Bottom" Height="36"
                                    Click="BtnAdicionarItemManual_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Popup x:Name="PopupResultadosProduto"
                       PlacementTarget="{Binding ElementName=TxtBuscaProduto}"
                       Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="White" CornerRadius="8"
                            BorderBrush="{StaticResource CinzaMedioBrush}" BorderThickness="1"
                            MinWidth="{Binding ActualWidth, ElementName=TxtBuscaProduto}"
                            MaxHeight="220" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.15"/>
                        </Border.Effect>
                        <ListBox x:Name="LstResultadosProduto" BorderThickness="0"
                                 MouseDoubleClick="LstResultadosProduto_MouseDoubleClick"
                                 SelectionChanged="LstResultadosProduto_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource CinzaTextoBrush}">
                                            <Run Text="{Binding CodigoInterno, Mode=OneWay}"/>
                                            <Run Text=" · Estoque: "/>
                                            <Run Text="{Binding QuantidadeEstoque, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Unidade, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <TextBlock x:Name="TxtErroValidacao" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource VermelhoErroBrush}" Visibility="Collapsed"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Itens do orçamento" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                    <DataGrid x:Name="GridItens" Style="{StaticResource DataGridModerno}"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderModerno}"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180"
                              CellEditEnding="GridItens_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoDescricao}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoProduto}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Produto/Serviço" Binding="{Binding NomeProduto}" Width="*"/>
                            <DataGridTextColumn Header="Un" Binding="{Binding Unidade}" Width="60"/>
                            <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Vlr Unit." Binding="{Binding PrecoUnitario, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Style="{StaticResource BotaoPerigo}"
                                                Padding="6,2" Click="BtnRemoverItem_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Observações (opcional)"/>
                        <TextBox x:Name="TxtObservacoes" Style="{StaticResource TextBoxModerno}"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Desconto (R$)"/>
                        <TextBox x:Name="TxtDesconto" Style="{StaticResource TextBoxNumerico}"
                                 TextChanged="TxtDesconto_TextChanged"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" Padding="20,15">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Subtotal:" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                        <TextBlock x:Name="TxtSubtotalOrcamento" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Total do orçamento:" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalOrcamento" FontWeight="Bold" FontSize="18"
                                   Foreground="{StaticResource AzulPrimarioBrush}" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                    <Button x:Name="BtnSalvarGerarPdf" Content="Salvar e Gerar PDF"
                            Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                            Click="BtnSalvarGerarPdf_Click"/>
                    <Button x:Name="BtnSalvar" Content="Salvar Orçamento"
                            Style="{StaticResource BotaoPrimario}"
                            Click="BtnSalvar_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
