<UserControl x:Class="ImperialColors.UI.Views.NaturezaOperacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/AppTheme.xaml"/>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ScrollViewerComMargem}" VerticalScrollBarVisibility="Auto">
    <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Lista -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Naturezas de Operação" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{StaticResource CinzaTextoBrush}" TextWrapping="Wrap" MaxWidth="260"
                           Text="Regras fiscais reutilizáveis (CFOP, CST/CSOSN, finalidade) para não redigitar em toda venda."/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,12">
                    <Button Content="+ Nova Natureza" Style="{StaticResource BotaoPrimario}"
                            Command="{Binding NovoCommand}" Margin="0,0,10,0"/>
                    <Button Content="⟳ Atualizar" Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CarregarCommand}"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Naturezas}"
                          SelectedItem="{Binding NaturezaSelecionada}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource DataGridModerno}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoOperacao}" Width="80"/>
                        <DataGridTextColumn Header="Finalidade" Binding="{Binding Finalidade}" Width="100"/>
                        <DataGridTextColumn Header="Série" Binding="{Binding Serie}" Width="60"/>
                        <DataGridTextColumn Header="CFOP Estado" Binding="{Binding CfopDentroEstado}" Width="90"/>
                        <DataGridTextColumn Header="CFOP Fora" Binding="{Binding CfopForaEstado}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Formulário -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding TituloFormulario}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="Descrição"/>
                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxModerno}" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="Tipo de Operação"/>
                <ComboBox x:Name="CmbTipoOperacao" Margin="0,0,0,10"
                          SelectionChanged="CmbTipoOperacao_SelectionChanged"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="Finalidade da Emissão"/>
                <ComboBox x:Name="CmbFinalidade" Margin="0,0,0,10"
                          SelectionChanged="CmbFinalidade_SelectionChanged"/>

                <CheckBox Content="Operação para consumidor final" Margin="0,0,0,10"
                          IsChecked="{Binding ConsumidorFinal}"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="Série (em branco = série padrão da empresa)"/>
                <TextBox Text="{Binding Serie, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxModerno}" Margin="0,0,0,10" MaxLength="3"/>

                <TextBlock Text="ICMS padrão (preencha apenas um, conforme o regime tributário)"
                           FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="CSOSN padrão (Simples Nacional/MEI)"/>
                <TextBox Text="{Binding CsosnPadrao, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxModerno}" Margin="0,0,0,10" MaxLength="3"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="CST de ICMS padrão (Regime Normal)"/>
                <TextBox Text="{Binding CstIcmsPadrao, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxModerno}" Margin="0,0,0,10" MaxLength="2"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="CFOP — venda dentro do estado"/>
                <TextBox Text="{Binding CfopDentroEstado, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxModerno}" Margin="0,0,0,10" MaxLength="4"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="CFOP — venda para outro estado"/>
                <TextBox Text="{Binding CfopForaEstado, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxModerno}" Margin="0,0,0,10" MaxLength="4"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="DIFAL não contribuinte (EC 87/2015)"/>
                <ComboBox x:Name="CmbDifal" Margin="0,0,0,10"
                          SelectionChanged="CmbDifal_SelectionChanged"/>

                <TextBlock Style="{StaticResource LabelCampo}" Text="Observações padrão da nota"/>
                <TextBox Text="{Binding ObservacoesPadrao, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxMultilinha}" Height="60" Margin="0,0,0,16"/>

                <Button Content="Salvar" Style="{StaticResource BotaoPrimario}"
                        Command="{Binding SalvarCommand}" Margin="0,0,0,8"/>
                <Button Content="Excluir" Style="{StaticResource BotaoPerigo}"
                        Command="{Binding ExcluirCommand}"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
