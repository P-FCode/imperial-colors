<UserControl x:Class="ImperialColors.UI.Views.AuditoriaLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/AppTheme.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="De:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Style="{StaticResource LabelCampo}"/>
                <DatePicker Grid.Column="1" Style="{StaticResource DatePickerModerno}"
                            SelectedDate="{Binding DataInicio, Mode=TwoWay}"/>

                <TextBlock Grid.Column="2" Text="Até:" VerticalAlignment="Center" Margin="12,0,6,0"
                           Style="{StaticResource LabelCampo}"/>
                <DatePicker Grid.Column="3" Style="{StaticResource DatePickerModerno}"
                            SelectedDate="{Binding DataFim, Mode=TwoWay}"/>

                <TextBlock Grid.Column="4" Text="Nível:" VerticalAlignment="Center" Margin="12,0,6,0"
                           Style="{StaticResource LabelCampo}"/>
                <ComboBox Grid.Column="5" Style="{StaticResource ComboBoxModerno}"
                          ItemsSource="{Binding Niveis}"
                          SelectedItem="{Binding NivelSelecionado}"/>

                <TextBlock Grid.Column="6" Text="Módulo:" VerticalAlignment="Center" Margin="12,0,6,0"
                           Style="{StaticResource LabelCampo}"/>
                <ComboBox Grid.Column="7" Style="{StaticResource ComboBoxModerno}"
                          ItemsSource="{Binding Modulos}"
                          SelectedItem="{Binding ModuloSelecionado}"/>

                <TextBox Grid.Column="8" Style="{StaticResource TextBoxModerno}" Margin="12,0,10,0"
                         Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="9" Style="{StaticResource BotaoPrimario}" Content="Filtrar"
                        Command="{Binding FiltrarCommand}" Padding="14,8"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding LogSelecionado}"
                      Style="{StaticResource DataGridModerno}"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderModerno}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      IsReadOnly="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora"
                                        Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm:ss}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Nível" Binding="{Binding NivelDescricao}" Width="90"/>
                    <DataGridTextColumn Header="Módulo" Binding="{Binding Modulo}" Width="120"/>
                    <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="180"/>
                    <DataGridTextColumn Header="Usuário" Binding="{Binding NomeUsuario}" Width="120"/>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource CinzaTextoBrush}"
                           Text="{Binding InfoPaginacao}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BotaoSecundario}" Content="◀ Anterior"
                            Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BotaoSecundario}" Content="Próxima ▶"
                            Command="{Binding PaginaProximaCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BotaoSecundario}" Content="Ver detalhes"
                            Command="{Binding VerDetalhesCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
