<UserControl x:Class="ImperialColors.UI.Views.NotaFiscalHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/AppTheme.xaml"/>
    </UserControl.Resources>

    <Grid Margin="22,20">
        <StackPanel x:Name="PainelCards" Visibility="Visible">
            <TextBlock Style="{StaticResource TituloModulo}" Text="Nota Fiscal"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,20" FontSize="12"
                       Foreground="{StaticResource CinzaTextoBrush}"
                       Text="Emissão de NF-e e NFC-e integrada à API Fiscal — escolha o tipo de nota para consultar, cadastrar e emitir."/>

            <UniformGrid Columns="2" Rows="1" MaxWidth="820" HorizontalAlignment="Left">
                <Button x:Name="BtnCardNFe" Style="{StaticResource SubmoduloCard}" Margin="0,0,16,0"
                        Click="BtnCardNFe_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F4C4;" FontSize="30" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Nota Fiscal Eletrônica (NF-e)" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PretoPrimarioBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Modelo 55 — vendas B2B/atacado, com destinatário identificado"
                                       FontSize="11" Foreground="{StaticResource CinzaTextoBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="BtnCardNFCe" Style="{StaticResource SubmoduloCard}"
                        Click="BtnCardNFCe_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F9FE;" FontSize="30" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Nota Fiscal do Consumidor (NFC-e)" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PretoPrimarioBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Modelo 65 — venda de balcão/PDV, com QR Code e impressão térmica"
                                       FontSize="11" Foreground="{StaticResource CinzaTextoBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Resumo de Notas Fiscais -->
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,24,0,0" MaxWidth="820" HorizontalAlignment="Left">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Resumo de Notas Fiscais" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnAtualizarResumo" Content="⟳  Atualizar" Style="{StaticResource BotaoSecundario}"
                                HorizontalAlignment="Right" Padding="10,5" FontSize="11" Click="BtnAtualizarResumo_Click"/>
                    </Grid>

                    <UniformGrid Columns="3" Rows="1" Margin="0,0,0,20">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="EMITIDAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                            <TextBlock x:Name="TxtTotalEmitidas" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource VerdeSucessoBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="CANCELADAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                            <TextBlock x:Name="TxtTotalCanceladas" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource VermelhoErroBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="VALOR TOTAL EMITIDO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                            <TextBlock x:Name="TxtValorTotalEmitido" Text="R$ 0,00" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource PretoPrimarioBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Últimas 10 notas" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid x:Name="GridUltimasNotas" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource DataGridModerno}" MaxHeight="300"
                              MouseDoubleClick="GridUltimasNotas_MouseDoubleClick"
                              ToolTip="Duplo clique para abrir a nota">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoDescricao}" Width="60"/>
                            <DataGridTextColumn Header="Série/Número" Binding="{Binding SerieNumero}" Width="100"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*"/>
                            <DataGridTextColumn Header="Emissão" Binding="{Binding DataEmissaoFormatada}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusFormatado}" Width="140"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding VNfFormatado}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtSemNotas" Text="Nenhuma nota emitida ainda." FontSize="12"
                               Foreground="{StaticResource CinzaTextoBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ContentControl x:Name="PainelListaNFe" Visibility="Collapsed"/>
        <ContentControl x:Name="PainelListaNFCe" Visibility="Collapsed"/>
    </Grid>
</UserControl>
