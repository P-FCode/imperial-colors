<UserControl x:Class="ImperialColors.UI.Views.NotaFiscalHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ImperialColors.UI.Helpers">

    <UserControl.Resources>
        <!-- URI absoluta (pack://): a relativa resolve contra o assembly de ENTRADA, o que
             funciona com o app rodando mas quebra ao construir a tela em teste (mesmo padrão
             de PDVView e VendasExternasView). -->
        <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PainelCards" Visibility="Visible"
                      Style="{StaticResource ScrollViewerComMargem}"
                      helpers:ScrollViewerMouseWheelHelper.Habilitar="True">
            <StackPanel Margin="26,22">
                <TextBlock Style="{StaticResource TituloModulo}" Text="Nota Fiscal"/>
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,22" FontSize="12"
                           Foreground="{StaticResource CinzaTextoBrush}"
                           Text="Emissão de NF-e e NFC-e integrada à API Fiscal — escolha o tipo de nota para consultar, cadastrar e emitir."/>

                <!-- Ação principal: escolher o tipo de nota -->
                <Grid MaxWidth="1120" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnCardNFe" Grid.Column="0" Style="{StaticResource SubmoduloCard}"
                            Margin="0,0,0,0" Click="BtnCardNFe_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x1F4C4;" FontSize="30" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nota Fiscal Eletrônica (NF-e)" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource PretoPrimarioBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="Modelo 55 — vendas B2B/atacado, com destinatário identificado"
                                           FontSize="11" Foreground="{StaticResource CinzaTextoBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="BtnCardNFCe" Grid.Column="2" Style="{StaticResource SubmoduloCard}"
                            Margin="0,0,0,0" Click="BtnCardNFCe_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x1F9FE;" FontSize="30" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nota Fiscal do Consumidor (NFC-e)" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource PretoPrimarioBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="Modelo 65 — venda de balcão/PDV, com QR Code e impressão térmica"
                                           FontSize="11" Foreground="{StaticResource CinzaTextoBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Painel de estatísticas -->
                <Grid Margin="0,26,0,10">
                    <TextBlock Text="Panorama" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAtualizarResumo" Content="⟳  Atualizar" Style="{StaticResource BotaoSecundario}"
                            HorizontalAlignment="Right" Padding="10,5" FontSize="11" Click="BtnAtualizarResumo_Click"/>
                </Grid>

                <!-- Tiles de indicadores -->
                <UniformGrid Columns="6" Rows="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2705;" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="EMITIDAS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTotalEmitidas" Text="0" Margin="0,10,0,0" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource VerdeSucessoBrush}"/>
                            <TextBlock x:Name="TxtEmitidasHoje" Text="0 hoje" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <Border Margin="0,10,0,0" Height="3" CornerRadius="2" Background="{StaticResource VerdeSucessoBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4B0;" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="VALOR EMITIDO" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtValorTotalEmitido" Text="R$ 0,00" Margin="0,10,0,0" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource PretoPrimarioBrush}"/>
                            <TextBlock x:Name="TxtValorEmitidoNoMes" Text="R$ 0,00 este mês" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <Border Margin="0,10,0,0" Height="3" CornerRadius="2" Background="{StaticResource AmareloPrimarioBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F9FE;" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="TICKET MÉDIO" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTicketMedio" Text="—" Margin="0,10,0,0" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource PretoPrimarioBrush}"/>
                            <TextBlock Text="Por nota autorizada" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <Border Margin="0,10,0,0" Height="3" CornerRadius="2" Background="{StaticResource AzulInfoBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F553;" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="PENDENTES" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTotalPendentes" Text="0" Margin="0,10,0,0" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <TextBlock Text="Rascunho ou a confirmar" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <Border Margin="0,10,0,0" Height="3" CornerRadius="2" Background="{StaticResource CinzaTextoBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="REJEITADAS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTotalRejeitadas" Text="0" Margin="0,10,0,0" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource LaranjaAvisoBrush}"/>
                            <TextBlock Text="Corrija e reemita" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <Border Margin="0,10,0,0" Height="3" CornerRadius="2" Background="{StaticResource LaranjaAvisoBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2716;" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="CANCELADAS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTotalCanceladas" Text="0" Margin="0,10,0,0" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource VermelhoErroBrush}"/>
                            <TextBlock Text="Canceladas na SEFAZ" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                            <Border Margin="0,10,0,0" Height="3" CornerRadius="2" Background="{StaticResource VermelhoErroBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Últimas notas + panorama por tipo/status -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Últimas Notas Emitidas" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <DataGrid x:Name="GridUltimasNotas" AutoGenerateColumns="False" IsReadOnly="True"
                                      Style="{StaticResource DataGridModerno}"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderModerno}" MaxHeight="420"
                                      MouseDoubleClick="GridUltimasNotas_MouseDoubleClick"
                                      ToolTip="Duplo clique para abrir a nota">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoDescricao}" Width="55"/>
                                    <DataGridTextColumn Header="Série/Número" Binding="{Binding SerieNumero}" Width="95"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*"/>
                                    <DataGridTextColumn Header="Emissão" Binding="{Binding DataEmissaoFormatada}" Width="125"/>
                                    <DataGridTemplateColumn Header="Status" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusCorFundo}" CornerRadius="4"
                                                        Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusFormatado}" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="{Binding StatusCorTexto}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding VNfFormatado}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtSemNotas" Text="Nenhuma nota emitida ainda." FontSize="12"
                                       Foreground="{StaticResource CinzaTextoBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <!-- Notas por tipo -->
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Notas por Tipo" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                <StackPanel x:Name="PainelBarrasTipo">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="NF-e" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtContagemNFe" Text="0 notas" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource CinzaTextoBrush}"/>
                                    </Grid>
                                    <Grid Height="10" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColBarraNFePreenchida" Width="1*"/>
                                            <ColumnDefinition x:Name="ColBarraNFeVazia" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource AzulPrimarioBrush}" CornerRadius="4" Margin="0,0,2,0"/>
                                        <Border Grid.Column="1" Background="{StaticResource CinzaMedioBrush}" CornerRadius="4" Margin="2,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtValorNFe" Text="R$ 0,00" FontSize="11"
                                               Foreground="{StaticResource CinzaTextoBrush}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="NFC-e" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtContagemNFCe" Text="0 notas" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource CinzaTextoBrush}"/>
                                    </Grid>
                                    <Grid Height="10" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColBarraNFCePreenchida" Width="1*"/>
                                            <ColumnDefinition x:Name="ColBarraNFCeVazia" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource AmareloPrimarioBrush}" CornerRadius="4" Margin="0,0,2,0"/>
                                        <Border Grid.Column="1" Background="{StaticResource CinzaMedioBrush}" CornerRadius="4" Margin="2,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtValorNFCe" Text="R$ 0,00" FontSize="11"
                                               Foreground="{StaticResource CinzaTextoBrush}"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtSemComparativoTipo" Visibility="Collapsed"
                                           Text="Ainda não há notas autorizadas para comparar." FontSize="12"
                                           Foreground="{StaticResource CinzaTextoBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Notas por status -->
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Notas por Status" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource VerdeSucessoBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Autorizadas" FontSize="12"/>
                                    <TextBlock x:Name="TxtStatusAutorizadas" Grid.Column="2" Text="0" FontSize="12" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource LaranjaAvisoBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Rejeitadas" FontSize="12"/>
                                    <TextBlock x:Name="TxtStatusRejeitadas" Grid.Column="2" Text="0" FontSize="12" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource CinzaTextoBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Pendentes" FontSize="12"/>
                                    <TextBlock x:Name="TxtStatusPendentes" Grid.Column="2" Text="0" FontSize="12" FontWeight="Bold"/>
                                </Grid>

                                <Grid x:Name="LinhaStatusDenegadas" Margin="0,0,0,10" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource VermelhoErroBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Denegadas" FontSize="12"/>
                                    <TextBlock x:Name="TxtStatusDenegadas" Grid.Column="2" Text="0" FontSize="12" FontWeight="Bold"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource VermelhoErroBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Canceladas" FontSize="12"/>
                                    <TextBlock x:Name="TxtStatusCanceladas" Grid.Column="2" Text="0" FontSize="12" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="PainelListaNFe" Visibility="Collapsed"/>
        <ContentControl x:Name="PainelListaNFCe" Visibility="Collapsed"/>
    </Grid>
</UserControl>
