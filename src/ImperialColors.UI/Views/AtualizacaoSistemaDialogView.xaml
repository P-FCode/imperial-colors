<Window x:Class="ImperialColors.UI.Views.AtualizacaoSistemaDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualizar Sistema" Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" BorderBrush="#E8E8E8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid Background="{StaticResource CinzaClaroBrush}" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="TxtTitulo" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PretoPrimarioBrush}"
                               Text="Atualizar Sistema"/>
                    <TextBlock x:Name="TxtSubtitulo" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource CinzaTextoBrush}"
                               Text="Consultando as versões publicadas..."/>
                </StackPanel>
                <Button x:Name="BtnFechar" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="BtnFechar_Click">
                    <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource CinzaTextoBrush}"/>
                </Button>
            </Grid>

            <!-- Comparação de versões -->
            <Border x:Name="PainelVersoes" Grid.Row="1" Margin="0,16,0,0" Padding="14"
                    CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource CinzaMedioBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Versão instalada" FontSize="11"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                        <TextBlock x:Name="TxtVersaoInstalada" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="→" FontSize="20" Margin="12,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource CinzaTextoBrush}"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nova versão" FontSize="11"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                        <TextBlock x:Name="TxtVersaoNova" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource VerdeSucessoBrush}"/>
                        <TextBlock x:Name="TxtTamanho" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Notas da release -->
            <Border x:Name="PainelNotas" Grid.Row="2" Margin="0,14,0,0" Padding="14"
                    CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource CinzaMedioBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtNomeRelease" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtNotas" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Mensagem central (sem atualização, erro, ou estado inicial) -->
            <Border x:Name="PainelMensagem" Grid.Row="2" Margin="0,14,0,0" Padding="18"
                    CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource CinzaMedioBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtIconeMensagem" FontSize="34" HorizontalAlignment="Center"
                               Text="⟳" Foreground="{StaticResource CinzaTextoBrush}"/>
                    <TextBlock x:Name="TxtMensagem" FontSize="13" Margin="0,12,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource CinzaTextoBrush}"
                               Text="Consultando o servidor..."/>
                </StackPanel>
            </Border>

            <!-- Progresso -->
            <StackPanel x:Name="PainelProgresso" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtEtapa" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource CinzaTextoBrush}"/>
                <ProgressBar x:Name="BarraProgresso" Height="6" Minimum="0" Maximum="100"
                             Foreground="{StaticResource VerdeSucessoBrush}"
                             Background="{StaticResource CinzaMedioBrush}" BorderThickness="0"/>
            </StackPanel>

            <!-- Ações -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="BtnCancelar" Style="{StaticResource BotaoSecundario}"
                        Content="Fechar" Margin="0,0,10,0" Click="BtnFechar_Click"/>
                <Button x:Name="BtnAtualizar" Style="{StaticResource BotaoPrimario}"
                        Content="Atualizar agora" Visibility="Collapsed"
                        Click="BtnAtualizar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
