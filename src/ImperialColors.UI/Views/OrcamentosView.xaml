<UserControl x:Class="ImperialColors.UI.Views.OrcamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImperialColors.UI.Converters"
             xmlns:helpers="clr-namespace:ImperialColors.UI.Helpers">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:MoedaConverter x:Key="MoedaConverter"/>
            <conv:DataConverter x:Key="DataConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource TituloModulo}" Text="Orçamentos"/>
                <TextBlock Text="Proposta comercial sem compromisso — não movimenta estoque nem financeiro"
                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding GerarPdfCommand}" Content="📄  Gerar PDF"/>
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding EditarOrcamentoCommand}" Content="✏  Editar"/>
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding AprovarCommand}" Content="✔  Aprovar"/>
                <Button Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                        Command="{Binding RecusarCommand}" Content="✖  Recusar"/>
                <Button Style="{StaticResource BotaoPerigo}" Margin="0,0,10,0"
                        Command="{Binding ExcluirOrcamentoCommand}" Content="🗑  Excluir"/>
                <Button Style="{StaticResource BotaoPrimario}"
                        Command="{Binding NovoOrcamentoCommand}" Content="+ Novo Orçamento"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="15">
            <TextBox Style="{StaticResource TextBoxFiltro}"
                     helpers:PlaceholderHelper.Text="Buscar por número, cliente ou telefone..."
                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="GridOrcamentos"
                      Style="{StaticResource DataGridModerno}" ColumnHeaderStyle="{StaticResource DataGridHeaderModerno}"
                      ItemsSource="{Binding Orcamentos}" SelectedItem="{Binding OrcamentoSelecionado}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Orçamento" Binding="{Binding NumeroOrcamento}" Width="170"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}" Width="*"/>
                    <DataGridTextColumn Header="Telefone" Binding="{Binding TelefoneCliente}" Width="130"/>
                    <DataGridTextColumn Header="Emissão" Binding="{Binding DataOrcamento, Converter={StaticResource DataConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Validade" Binding="{Binding DataValidade, Converter={StaticResource DataConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Itens" Binding="{Binding TotalItens}" Width="60"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource MoedaConverter}}" Width="110"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusDescricao}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource CinzaTextoBrush}"
                           Text="{Binding InfoPaginacao}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BotaoSecundario}" Content="◀ Anterior"
                            Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BotaoSecundario}" Content="Próxima ▶"
                            Command="{Binding PaginaProximaCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
