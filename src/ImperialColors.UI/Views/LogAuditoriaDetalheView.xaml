<Window x:Class="ImperialColors.UI.Views.LogAuditoriaDetalheView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhe do Log" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource CinzaClaroBrush}">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/AppTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Detalhes da Auditoria" Style="{StaticResource TituloModulo}" FontSize="18"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCampo}" Text="Data/Hora"/>
                    <TextBlock x:Name="TxtDataHora" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCampo}" Text="Nível"/>
                    <TextBlock x:Name="TxtNivel" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCampo}" Text="Módulo / Ação"/>
                    <TextBlock x:Name="TxtModuloAcao" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCampo}" Text="Usuário"/>
                    <TextBlock x:Name="TxtUsuario" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCampo}" Text="Descrição"/>
                    <TextBlock x:Name="TxtDescricao" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCampo}" Text="Payload / StackTrace (JSON)"/>
                    <TextBox x:Name="TxtPayload" Style="{StaticResource TextBoxMultilinha}"
                             IsReadOnly="True" MinHeight="180" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource BotaoPrimario}" Content="Fechar" Click="BtnFechar_Click"/>
    </Grid>
</Window>
