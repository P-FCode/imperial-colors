<UserControl x:Class="ImperialColors.UI.Views.NotaFiscalListaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/AppTheme.xaml"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnVoltar" Content="&#x2190; Módulos" Style="{StaticResource BotaoSecundario}"
                        Margin="0,0,14,0" Click="BtnVoltar_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="CmbFiltroStatus" Style="{StaticResource ComboBoxModerno}" MinWidth="180"
                              SelectionChanged="CmbFiltroStatus_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x27F3; Atualizar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                            Click="BtnAtualizar_Click"/>
                    <Button x:Name="BtnExcluirNota" Content="Excluir" Style="{StaticResource BotaoPerigo}"
                            Margin="0,0,10,0" IsEnabled="False" Click="BtnExcluirNota_Click"/>
                    <Button x:Name="BtnAcoesDaNota" Content="Ações da Nota" Style="{StaticResource BotaoSecundario}"
                            Margin="0,0,10,0" IsEnabled="False" Click="BtnAcoesDaNota_Click"/>
                    <Button Content="+ Criar Nota" Style="{StaticResource BotaoPrimario}" Click="BtnCriarNota_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="1" x:Name="GridNotas" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource DataGridModerno}"
                      SelectionChanged="GridNotas_SelectionChanged"
                      MouseDoubleClick="GridNotas_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Série/Número" Binding="{Binding SerieNumero}" Width="110"/>
                    <DataGridTextColumn Header="Emissão" Binding="{Binding DataEmissaoFormatada}" Width="140"/>
                    <DataGridTextColumn Header="Destinatário" Binding="{Binding ClienteNome}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusFormatado}" Width="130"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding VNfFormatado}" Width="110"/>
                    <DataGridTextColumn Header="Chave de Acesso" Binding="{Binding ChaveAcesso}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
